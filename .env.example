# ==========================================
# Sojar Indusy - Environment Configuration
# ==========================================

# Supabase Public API Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Backend Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email: Brevo is configured as Supabase's custom SMTP provider and sends all
# auth mail (confirmation, password recovery). No email credentials belong here.
